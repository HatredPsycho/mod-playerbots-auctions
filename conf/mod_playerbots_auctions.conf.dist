#
# mod-playerbots-auctions
#
# The random bots of mod-playerbots take part in the economy like players: they go to the auction
# house when they feel it is time, sell what they do not need, buy what they can use, and work with
# their professions. Every bot has a character of its own, and behaves accordingly.
#
# Needs mod-playerbots. It adds to it and does not change it.
#

[worldserver]

###################################################################################################
# GENERAL

#
#    PlayerbotsAuctions.Enable
#        Description: Switches the module on.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Enable = 1

#
#    PlayerbotsAuctions.Debug
#        Description: Writes to the server log what the bots do: every trip, auction, bid, purchase
#                     and crafted item, and every five minutes a summary: what the bots carry, what they gathered (ore, herbs,
#                     hides, cloth), which professions they have and what comes of their recipes.
#        Default:     0 - Disabled
#                     1 - Enabled

PlayerbotsAuctions.Debug = 0

#
#    PlayerbotsAuctions.AuctioneerRange
#        Description: Bots sell and buy at an auctioneer, like a player. This is how close (yards)
#                     they have to stand.
#        Default:     35

PlayerbotsAuctions.AuctioneerRange = 35

#
#    PlayerbotsAuctions.MinBotLevel
#        Description: Bots below this level do not use the auction house.
#        Default:     1

PlayerbotsAuctions.MinBotLevel = 1

#
#    PlayerbotsAuctions.CollectAuctionMail
#        Description: A bot at the auction house empties its auction mail: the money of sold items,
#                     the items nobody bought and what it bought. Without this that mail piles up,
#                     because the bots never open a mailbox for it.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.CollectAuctionMail = 1

#
#    PlayerbotsAuctions.DailyRhythm
#        Description: More is going on in the evening and at the weekend than at night, by the
#                     server's clock: fewer bots set out for the auction house at four in the morning.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.DailyRhythm = 1

#
#    PlayerbotsAuctions.SaveMemory
#        Description: The bots remember what things sold for and what came back unsold. With this
#                     option that memory survives a restart, in two small tables of the characters
#                     database (mod_playerbots_auctions_market, mod_playerbots_auctions_unsold).
#                     They are created when the server starts.
#        Default:     1 - Enabled
#                     0 - Disabled (the market starts from scratch at every restart)

PlayerbotsAuctions.SaveMemory = 1

#
#    PlayerbotsAuctions.PauseAuctionsWhileOffline
#        Description: Auctions run out by the clock on the wall, also while the server is off. On a
#                     server that is only started for an evening, most auctions are gone by the next
#                     evening and the auction house starts empty every day. With this option every
#                     auction - of bots and of players - gets back the time the server was off when
#                     it starts: an auction put up for 24 hours runs for 24 hours of server time.
#                     The module notes once a minute that the server is running, in a small table
#                     of the characters database (mod_playerbots_auctions_state). On a server that
#                     runs around the clock this changes nothing worth mentioning.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.PauseAuctionsWhileOffline = 1

###################################################################################################
# CHARACTER
#
#    Every bot has a character of its own that never changes, made of these traits:
#
#      order      - collects until nothing fits ... tidies up early
#      patience   - wants to be rid of it now   ... waits for a good price
#      knowledge  - prices by gut feeling       ... knows the market
#      thrift     - spends what it has          ... keeps a reserve
#      trading    - hardly uses the auctions    ... lives in the auction house
#      crafting   - profession is a sideline    ... produces on purpose
#
#    Everything below follows from them: when a bot goes to the auction house, how it prices, how
#    long its auctions run, whether it bids or buys outright, how much it spends, what kind of
#    crafter it is. The traits cannot be configured; the settings in this file set the frame.

#
#    PlayerbotsAuctions.Character.AvoidersPercent
#        Description: Percent of the bots that never use the auction house and sell everything to a
#                     vendor, as many players do.
#        Default:     15

PlayerbotsAuctions.Character.AvoidersPercent = 15

###################################################################################################
# PACE

#
#    PlayerbotsAuctions.IntervalSeconds
#        Description: How often the module looks at the bots.
#        Default:     30

PlayerbotsAuctions.IntervalSeconds = 30

#
#    PlayerbotsAuctions.BotsPerCycle
#        Description: How many bots may do their business per look. Keeps the load even with
#                     thousands of bots.
#        Default:     10

PlayerbotsAuctions.BotsPerCycle = 10

#
#    PlayerbotsAuctions.VisitCooldownMinutesMin
#    PlayerbotsAuctions.VisitCooldownMinutesMax
#        Description: A bot that was at the auctioneers and stays near them does its business again
#                     after a random time between these two values - times 0.4 for a bot that lives
#                     in the auction house, up to times 1.6 for one that hardly uses it.
#        Default:     20 and 60

PlayerbotsAuctions.VisitCooldownMinutesMin = 20
PlayerbotsAuctions.VisitCooldownMinutesMax = 60

###################################################################################################
# TRIPS TO THE AUCTION HOUSE
#
#    Like a player, a bot decides for itself when it is time to go: when its bags are getting full,
#    or when it has collected enough to sell. Where it draws these lines follows from its character.
#    A bot that is in a capital anyway goes for less, but not every time.
#
#    A bot in town walks to the auctioneers. A bot out in the world - Northrend and Outland
#    included - takes its hearth to a capital of its faction (picked at random), arrives at the bank
#    or inn, walks to the auctioneers, stays in town for a while and returns to where it was.
#
#    Needs the city visits of the CoA Playerbots fork; with other versions of mod-playerbots the
#    bots are not sent anywhere and only do their business when they happen to pass an auctioneer.

#
#    PlayerbotsAuctions.CityTrip.Enable
#        Description: Bots set out for the auction house on their own.
#        Default:     1 - Enabled
#                     0 - Disabled (bots only do their business when they happen to pass an auctioneer)

PlayerbotsAuctions.CityTrip.Enable = 1

#
#    PlayerbotsAuctions.CityTrip.CooldownMinutesMin
#    PlayerbotsAuctions.CityTrip.CooldownMinutesMax
#        Description: After a trip a bot waits a random time between these two values before the
#                     next one - times 0.5 for a bot that lives in the auction house, up to times
#                     1.35 for one that hardly uses it.
#        Default:     60 and 180

PlayerbotsAuctions.CityTrip.CooldownMinutesMin = 60
PlayerbotsAuctions.CityTrip.CooldownMinutesMax = 180

#
#    PlayerbotsAuctions.CityTrip.ItemsMin
#        Description: A bot sets out when it carries this many different things to sell. Every bot
#                     draws its own line between ItemsMin (tidy bots) and ItemsMax (bots that
#                     collect for long). Keep both low: mod-playerbots sells the same things to
#                     any vendor a bot passes, so bots rarely carry many. A bot that is in town
#                     anyway goes with a single thing, and full bags always send it off.
#        Default:     2

PlayerbotsAuctions.CityTrip.ItemsMin = 2

#
#    PlayerbotsAuctions.CityTrip.ItemsMax
#        Description: See ItemsMin: the line of the bots that collect the longest.
#        Default:     8

PlayerbotsAuctions.CityTrip.ItemsMax = 8

###################################################################################################
# SELLING
#
#    A bot only sells what it does not need itself (its own judgement: not an upgrade, not for a
#    quest, not for its professions), what is not soulbound and what a vendor would pay for.
#    Items that bind when picked up and quest items are never sold.
#
#    How a bot sells follows from its character: one that knows the market goes just below the
#    cheapest offer, one that does not guesses - too low or far too high. Stacks go up as packs of
#    1, 5, 10 or 20 or as a whole. The impatient list for 12 hours and take what they get, the
#    patient for 48 hours. What comes back unsold goes up again for less - once for the impatient,
#    up to three times for the patient; after that the bot gives that kind of item to the vendor.
#
#    Qualities: 0 poor (grey), 1 normal (white), 2 uncommon (green), 3 rare (blue), 4 epic (purple),
#               5 legendary

#
#    PlayerbotsAuctions.Sell.MinQuality.Equipment
#        Description: Lowest quality of weapons and armor that is sold.
#        Default:     2

PlayerbotsAuctions.Sell.MinQuality.Equipment = 2

#
#    PlayerbotsAuctions.Sell.MinQuality.Other
#        Description: Lowest quality of everything else (trade goods, consumables, recipes, ...).
#        Default:     1

PlayerbotsAuctions.Sell.MinQuality.Other = 1

#
#    PlayerbotsAuctions.Sell.MaxQuality
#        Description: Highest quality that is sold: 2 uncommon, 3 rare, 4 epic, 5 legendary. Whatever
#                     can be traded may be offered, so the default leaves it open at the top.
#        Default:     5

PlayerbotsAuctions.Sell.MaxQuality = 5

#
#    PlayerbotsAuctions.Sell.ItemClasses
#        Description: Item classes that are sold, separated by commas.
#                     0 consumable, 1 container, 2 weapon, 3 gem, 4 armor, 5 reagent, 6 projectile,
#                     7 trade goods, 9 recipe, 11 quiver, 13 key, 15 miscellaneous, 16 glyph
#                     12 quest (only what can be traded - most of it cannot), 15 includes companion
#                     pets and mounts. Projectiles are left out: bots are handed their ammunition.
#        Default:     "0,1,2,3,4,5,7,9,11,12,13,15,16"

PlayerbotsAuctions.Sell.ItemClasses = "0,1,2,3,4,5,7,9,11,12,13,15,16"

#
#    PlayerbotsAuctions.Sell.ExcludedItemIDs
#        Description: Items that are never sold, separated by commas.
#        Default:     ""

PlayerbotsAuctions.Sell.ExcludedItemIDs = ""

#
#    PlayerbotsAuctions.Sell.ExcludedNameParts
#        Description: Items whose name contains one of these texts are never sold (upper and lower
#                     case do not matter). Keeps test and technical items out of the auction house.
#                     The texts are separated by commas and taken exactly as written, spaces
#                     included: " test " only matches the single word.
#        Default:     "monster -,deprecated,[ph],(test), test ,qatest,qa ,zzold,npc equip,unused"

PlayerbotsAuctions.Sell.ExcludedNameParts = "monster -,deprecated,[ph],(test), test ,qatest,qa ,zzold,npc equip,unused"

#
#    PlayerbotsAuctions.Sell.ChargeDeposit
#        Description: Bots pay the normal deposit, get it back when the item sells and lose it if
#                     nobody buys - as players do. It does not decide what is offered.
#        Default:     1 - Enabled
#                     0 - Disabled (bots list for free)

PlayerbotsAuctions.Sell.ChargeDeposit = 1

#
#    PlayerbotsAuctions.Sell.MinAuctionValueSilver
#        Description: An auction that would bring less than this is not created. Low-level bots
#                     carry little of value: with a higher value they hardly sell anything.
#        Default:     1

PlayerbotsAuctions.Sell.MinAuctionValueSilver = 1

#
#    PlayerbotsAuctions.Sell.KeepFromVendor
#        Description: Where mod-playerbots lets bots sell to vendors, it sells whatever a bot does
#                     not need - also what would be worth an auction. With this the bots do not
#                     give a vendor what is meant for the auction house (worth at least
#                     MinAuctionValueSilver, not offered in vain too often) or the materials they
#                     have plans for. Bots that never use the auction house and bots travelling
#                     with a player are left alone. Needs CityTrip.Enable: bots that never get to
#                     an auctioneer keep nothing.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Sell.KeepFromVendor = 1

#
#    PlayerbotsAuctions.Sell.JunkToVendor
#        Description: A bot standing next to a vendor sells it what it has no use for and what is
#                     not worth an auction: grey things, plain equipment, what nobody wanted at
#                     the auction house. Random bots of mod-playerbots do not sell to vendors by
#                     themselves; without this their bags fill up with junk.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Sell.JunkToVendor = 1

#
#    PlayerbotsAuctions.Sell.MaxAuctionsPerHouse
#        Description: Bots stop selling in an auction house that holds this many auctions.
#        Default:     20000

PlayerbotsAuctions.Sell.MaxAuctionsPerHouse = 20000

###################################################################################################
# PRICES
#
#    The starting point of every price is the vendor value of an item times the factor of its
#    quality. What auctions really sell for moves that "usual price" over time.

#
#    PlayerbotsAuctions.Price.Poor
#    PlayerbotsAuctions.Price.Normal
#    PlayerbotsAuctions.Price.Uncommon
#    PlayerbotsAuctions.Price.Rare
#    PlayerbotsAuctions.Price.Epic
#    PlayerbotsAuctions.Price.Legendary
#        Description: Factor on the vendor value, per quality of the item.
#        Default:     1.5 - (PlayerbotsAuctions.Price.Poor)
#                     3   - (PlayerbotsAuctions.Price.Normal)
#                     6   - (PlayerbotsAuctions.Price.Uncommon)
#                     12  - (PlayerbotsAuctions.Price.Rare)
#                     25  - (PlayerbotsAuctions.Price.Epic)
#                     50  - (PlayerbotsAuctions.Price.Legendary)

PlayerbotsAuctions.Price.Poor = 1.5
PlayerbotsAuctions.Price.Normal = 3
PlayerbotsAuctions.Price.Uncommon = 6
PlayerbotsAuctions.Price.Rare = 12
PlayerbotsAuctions.Price.Epic = 25
PlayerbotsAuctions.Price.Legendary = 50

#
#    PlayerbotsAuctions.Price.LearnFromSales
#        Description: What auctions really sold for moves what the bots consider the usual price of
#                     an item, for selling and for buying. Only sales a bot took part in count, an
#                     item needs three sales before its price is "known", and every sale is cut
#                     down to between half and three times the calculated price.
#        Default:     1 - Enabled
#                     0 - Disabled (always vendor value times quality factor)

PlayerbotsAuctions.Price.LearnFromSales = 1

#
#    PlayerbotsAuctions.Price.MinVendorFactor
#        Description: No bot sells for less than the vendor value times this factor, however low
#                     the other offers are - neither as buyout price nor as starting bid.
#        Default:     1.5

PlayerbotsAuctions.Price.MinVendorFactor = 1.5

#
#    PlayerbotsAuctions.Price.MaxBuyoutGold
#        Description: Highest buyout price of one auction, in gold. A bot keeps an item that would
#                     be worth more, and does not pay more than this for an auction. 0 = no limit.
#        Default:     5000

PlayerbotsAuctions.Price.MaxBuyoutGold = 5000

###################################################################################################
# BUYING
#
#    A bot at the auction house looks through some of the items on offer for things it has a use
#    for: an upgrade for its equipment, things it uses up, a bag for a free bag slot, materials for
#    its professions. Of several offers of the same item it takes the cheapest. What it is willing
#    to pay depends on the usual price, on how much it wants the item and on how well off it is. The
#    patient bid low and wait, the impatient pay the buyout price. Traders buy what is clearly too
#    cheap to sell it on, and now and then a bot that is easy with its money simply has to have
#    something and pays well above the usual price.

#
#    PlayerbotsAuctions.Buy.Enable
#        Description: Bots buy and bid.
#        Default:     1 - Enabled
#                     0 - Disabled (bots only sell)

PlayerbotsAuctions.Buy.Enable = 1

#
#    PlayerbotsAuctions.Buy.ItemsLookedAt
#        Description: How many randomly picked items on offer a bot looks at per visit.
#        Default:     60

PlayerbotsAuctions.Buy.ItemsLookedAt = 60

#
#    PlayerbotsAuctions.Buy.FromPlayers
#        Description: Bots buy the auctions of players.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Buy.FromPlayers = 1

#
#    PlayerbotsAuctions.Buy.FromBots
#        Description: Bots buy the auctions of other bots.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Buy.FromBots = 1

#
#    PlayerbotsAuctions.Buy.PlaceBids
#        Description: Bots also bid instead of only buying outright. A bid can outbid a player.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Buy.PlaceBids = 1

#
#    PlayerbotsAuctions.Buy.UseBotMoney
#        Description: Bots pay with their own money and cannot buy what they cannot afford. Thrifty
#                     bots keep a reserve.
#        Default:     1 - Enabled
#                     0 - Disabled (bots always have enough money; this brings new gold into the world)

PlayerbotsAuctions.Buy.UseBotMoney = 1

#
#    PlayerbotsAuctions.Buy.MinVendorFactor
#        Description: For something it wants, a bot is always willing to pay at least the vendor
#                     value times this factor, so selling to the bots is never worse than selling to
#                     a vendor.
#        Default:     1.2

PlayerbotsAuctions.Buy.MinVendorFactor = 1.2

#
#    PlayerbotsAuctions.Buy.VendorItemMaxPercent
#        Description: For items a vendor sells, bots pay at most this percent of the vendor's price.
#                     Otherwise players could buy from a vendor and sell to the bots for a profit.
#        Default:     75

PlayerbotsAuctions.Buy.VendorItemMaxPercent = 75

###################################################################################################
# CRAFTING
#
#    mod-playerbots gives the bots professions and recipes, but the bots do not craft on their own.
#    With this option a bot at the auctioneers thinks through its recipes and compares what the
#    product would bring with what the materials cost - those it carries, those on offer in the
#    auction house, those a vendor sells. What kind of crafter it is follows from its character:
#
#      - for the casual one the profession is a sideline: it makes the first thing that works out
#        with what it carries;
#      - the one in between provides for itself and works on its skill, and buys what is missing;
#      - the producer thinks through all its recipes, takes the one that pays best and makes
#        several in a row.
#
#    What a bot makes and does not need itself it sells. Bots also stock up on materials for their
#    professions when the price is right (see BUYING).

#
#    PlayerbotsAuctions.Crafting.Enable
#        Description: Bots craft.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Crafting.Enable = 1

#
#    PlayerbotsAuctions.Crafting.WalkToAnvilForgeFire
#        Description: For a recipe that needs an anvil, a forge, a cooking fire or the like, the bot
#                     walks to the nearest one in the capital it is in, makes its things there and
#                     walks back to the auctioneers to sell them.
#        Default:     1 - Enabled
#                     0 - Disabled (such recipes are left out)

PlayerbotsAuctions.Crafting.WalkToAnvilForgeFire = 1

#
#    PlayerbotsAuctions.Crafting.BuyMaterials
#        Description: Bots buy the materials a recipe is missing when the product is worth it.
#        Default:     1 - Enabled
#                     0 - Disabled (bots only craft from what they carry)

PlayerbotsAuctions.Crafting.BuyMaterials = 1

#
#    PlayerbotsAuctions.Crafting.BuyVendorMaterials
#        Description: Materials a vendor sells for money in any quantity (thread, vials, flux, ...)
#                     the bot buys from the vendor at the vendor's price when it crafts.
#        Default:     1 - Enabled
#                     0 - Disabled (recipes that need such materials only work if the bot carries them)

PlayerbotsAuctions.Crafting.BuyVendorMaterials = 1

#
#    PlayerbotsAuctions.Crafting.MinProfitPercent
#        Description: The product has to be worth this many percent more than its materials.
#        Default:     10

PlayerbotsAuctions.Crafting.MinProfitPercent = 10

#
#    PlayerbotsAuctions.Crafting.SkillUpBonusPercent
#        Description: A recipe that still raises the bot's skill is worth this many percent more to
#                     it, so bots also craft at a loss to get better - as players do who level a
#                     profession. Most crafted things are worth less than what goes into them; with
#                     a low value smiths and tailors hardly make anything.
#        Default:     100

PlayerbotsAuctions.Crafting.SkillUpBonusPercent = 100

#
#    PlayerbotsAuctions.Crafting.MaxMaterialPriceFactor
#        Description: A bot does not pay any price for a material just because the product is worth
#                     a lot: offers above this factor times the usual price of the material are left
#                     alone.
#        Default:     1.5

PlayerbotsAuctions.Crafting.MaxMaterialPriceFactor = 1.5

#
#    PlayerbotsAuctions.Crafting.RecipesPerVisit
#        Description: How many of its recipes a bot thinks through per visit.
#        Default:     40

PlayerbotsAuctions.Crafting.RecipesPerVisit = 40

#
#    PlayerbotsAuctions.Crafting.MaxInARow
#        Description: The most a producer makes of one thing in one go.
#        Default:     5

PlayerbotsAuctions.Crafting.MaxInARow = 5

#
#    PlayerbotsAuctions.Crafting.TakeApart
#        Description: Jewelcrafters prospect ore, scribes mill herbs and enchanters disenchant gear
#                     they have no use for - when what comes out on average is worth more than
#                     what goes in, or when they need it for their own recipes.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Crafting.TakeApart = 1

#
#    PlayerbotsAuctions.Crafting.Scrolls
#        Description: Enchanters put their enchantments on vellum and sell the scrolls - the way an
#                     enchantment gets into the auction house. They need the materials, their rod and
#                     a vellum, which scribes make. A scroll is priced by what goes into it.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Crafting.Scrolls = 1

#
#    PlayerbotsAuctions.Crafting.Glyphs
#        Description: Scribes make glyphs. The glyphs of Wrath of the Lich King change the spells of
#                     the old classes; the classes of Conquest of Azeroth cannot use them, so nobody
#                     buys them there. Without glyphs scribes make inks, scrolls, vellum, cards and
#                     books. Enable on a server with the old classes.
#        Default:     0 - Disabled
#                     1 - Enabled

PlayerbotsAuctions.Crafting.Glyphs = 0

###################################################################################################
# DEALS BY CHAT
#
#    A player writes into a channel - General, Trade or any other; not /say, /yell or a whisper -
#    what he wants to buy or sell, and bots answer by whisper:
#
#        WTB copper ore                 WTS 20 linen cloth
#        wtb 20 copper ore 15s          wts [Linen Cloth] x20 for 10s
#
#    The item can be typed out or linked with a shift-click; a number before it says how many, a
#    price after it what the player has in mind ("5s", "1g20s", "50c each"). The words that are
#    understood: WTB, LTB, buying, want to buy, looking to buy, looking for, LF - and WTS, LTS,
#    selling, want to sell, looking to sell.
#
#    A bot that has the item to spare, or a use for it, names its price. The player answers the
#    whisper with "yes", "no", another price or another number of pieces; a bot gives way a little
#    on the price, depending on its character.
#
#        Prices:  3g   3 gold   1g20s   3 gold 2 silver 1 copper   three gold   3.92   3,92   50s each
#                 (a price needs a unit, or a point or comma: "3.92" is 3 gold 92 silver)
#        Pieces:  only need 3   3 of them   x5   2 stacks   half   all   ("3 for 20s" does both)
#                 (a bare number is a number of pieces)
# The goods go by mail, cash on delivery: a bot that sells sends the parcel, a bot
#    that buys pays for the parcel the player sends it - if it holds what was agreed, for no more
#    than was agreed. Only bots of the player's own faction answer, because mail does not cross.
#
#    mod-playerbots has a reply of its own to "WTS [item]": every bot that hears it may whisper
#    "I'll buy ... for ..." - dozens at once, and none of them means it. The module carries a small
#    change for mod-playerbots that keeps it quiet while this is enabled.
#
###################################################################################################

#
#    PlayerbotsAuctions.Chat.Enable
#        Description: Bots answer WTB and WTS lines of players.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Chat.Enable = 1

#
#    PlayerbotsAuctions.Chat.Answers
#        Description: How many bots answer one line at the most (1 to 10). They answer one after the
#                     other, a few seconds apart, each with its own price.
#        Default:     3

PlayerbotsAuctions.Chat.Answers = 3

#
#    PlayerbotsAuctions.Chat.Channels
#        Description: The channels the bots read, as parts of their names separated by commas, for
#                     example "general, trade". Empty: every channel.
#        Default:     ""

PlayerbotsAuctions.Chat.Channels = ""

#
#    PlayerbotsAuctions.Chat.Meet
#        Description: A bot that is close to the player says so with its offer; "meet" then takes
#                     the offer and brings the bot over. A bot that was answered with "yes" asks
#                     whether to meet instead of using the mail. On "meet" it joins the player's group for
#                     the way (that is how a bot finds a player), walks over, opens the trade
#                     window, puts in what was agreed and accepts when the other side holds what
#                     was agreed as well. Then it leaves the group again. If it cannot get there
#                     within two minutes, or the trade is closed, the deal goes through the mail.
#        Default:     1 - Enabled
#                     0 - Disabled (always the mail)

PlayerbotsAuctions.Chat.Meet = 1

#
#    PlayerbotsAuctions.Chat.MeetDistance
#        Description: How close the bot has to be to offer that, in yards, on the same map and
#                     outside of dungeons. A large value (1000 and more) lets nearly every bot of
#                     the zone offer it, which is handy for trying it out - the walk can then take
#                     longer than the two minutes a bot gives itself. 5000 at the most.
#        Default:     150

PlayerbotsAuctions.Chat.MeetDistance = 150

#
#    PlayerbotsAuctions.Chat.MailDelay
#        Description: How long the parcel of a bot takes to arrive, in seconds. -1: as long as mail
#                     between players takes on this server (Mail.DeliveryDelay in worldserver.conf,
#                     one hour unless changed). 0: at once.
#        Default:     -1

PlayerbotsAuctions.Chat.MailDelay = -1

###################################################################################################
# TRADING POST
#
#    Bots use up most of what they gather, and some things - ore above all - they hardly come by.
#    A player who needs twenty copper ore and finds none in the auction house has nowhere to go.
#    Every auctioneer therefore runs a trading post as well. A click on an auctioneer first asks:
#
#        Browse the auction house.
#        Buy at the Horde Trading Post.        (Alliance, Goblin: by the auctioneer)
#        What is the Trading Post?
#
#    The post opens in the game's own auction window - search, categories, filters and sorting
#    work as usual - and shows its own goods there, each with a buyout price. What is bought comes
#    by mail at once, from the auctioneer. The tabs for bids and for one's own auctions keep
#    showing the real auction house.
#
#    It is a last resort and built to stay one:
#      - It sells materials (ore, stone, bars, herbs, cloth, leather, enchanting materials,
#        elementals, uncut gems, meat and fish, parts) and what crafters make for everybody
#        (potions, elixirs, flasks, meals, scrolls, armor kits, cut gems and the like). No
#        equipment, no recipes, nothing that needs a profession to be used, nothing a vendor
#        sells anyway, nothing that binds.
#      - Only what the world really gives: what is in a loot table, and what a recipe makes of
#        that. The many unfinished items of an item table never show up.
#      - Only what the auction house next to it is short of right now. What the auction house
#        has, the post does not carry.
#      - For a multiple of what the thing usually goes for among the bots.
#      - In small amounts: so many pieces of one thing for a character a day.
#    Only players can use it. The money is gone from the world.
#
#    Once a day a player can haggle. The trader is in another mood every day - proud, greedy, in a
#    hurry, kindly or wary; how it greets tells - and three times the player picks one of three
#    things to say. What goes down well with one kind of trader annoys another, and the same line
#    twice works less. That moves the player's prices for the day by up to a third, either way.
#
###################################################################################################

#
#    PlayerbotsAuctions.TradingPost.Enable
#        Description: Auctioneers offer the trading post. Disabled, a click on an auctioneer
#                     opens the auction house as always.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.TradingPost.Enable = 1

#
#    PlayerbotsAuctions.TradingPost.ScarceBelow
#        Description: The post sells a material while the auction house holds fewer pieces of it
#                     than this, all auctions together (a single ore in the auction house helps
#                     nobody). What crafters make is sold while the auction house has none of it.
#        Default:     10
#                     0 - The post sells everything it knows, whatever the auction house holds

PlayerbotsAuctions.TradingPost.ScarceBelow = 10

#
#    PlayerbotsAuctions.TradingPost.Price.Materials
#    PlayerbotsAuctions.TradingPost.Price.Crafted
#        Description: What the post asks, as a multiple of what the thing usually goes for among
#                     the bots (the same value their own prices start from). Haggling moves it by
#                     up to a third. 1 to 100.
#        Default:     3.0 for materials, 4.0 for what crafters make

PlayerbotsAuctions.TradingPost.Price.Materials = 3.0
PlayerbotsAuctions.TradingPost.Price.Crafted = 4.0

#
#    PlayerbotsAuctions.TradingPost.Daily.Materials
#    PlayerbotsAuctions.TradingPost.Daily.Crafted
#        Description: How many pieces of one thing a character can buy a day (1 to 100). The day
#                     ends at midnight, server time.
#        Default:     20 of a material, 5 of a crafted thing

PlayerbotsAuctions.TradingPost.Daily.Materials = 20
PlayerbotsAuctions.TradingPost.Daily.Crafted = 5

#
#    PlayerbotsAuctions.TradingPost.Haggle
#        Description: Players haggle with the trader once a day before they see the goods.
#        Default:     1 - Enabled
#                     0 - Disabled (everybody pays the asking price)

PlayerbotsAuctions.TradingPost.Haggle = 1

#
#    PlayerbotsAuctions.TradingPost.MaxQuality
#        Description: The best quality the post sells: 1 common (white), 2 uncommon (green),
#                     3 rare (blue), 4 epic (purple).
#        Default:     3

PlayerbotsAuctions.TradingPost.MaxQuality = 3

#
#    PlayerbotsAuctions.TradingPost.ExcludedItemIDs
#        Description: Items the post never sells, separated by commas. The default keeps out what
#                     is meant to be scarce: materials made on a cooldown (Arcanite Bar, Mooncloth,
#                     Cured Rugged Hide, Primal Mooncloth, Primal Might, Spellcloth, Shadowcloth,
#                     Titansteel Bar, Ebonweave, Moonshroud, Spellweave) and the orbs of the
#                     Northrend dungeons and raids (Frozen Orb, Runed Orb, Crusader Orb, Primordial
#                     Saronite). The items of PlayerbotsAuctions.Sell.ExcludedItemIDs and the
#                     names of PlayerbotsAuctions.Sell.ExcludedNameParts are kept out as well.
#        Default:     "12360,14342,15407,21845,23571,24271,24272,37663,41593,41594,41595,43102,45087,47556,49908"

PlayerbotsAuctions.TradingPost.ExcludedItemIDs = "12360,14342,15407,21845,23571,24271,24272,37663,41593,41594,41595,43102,45087,47556,49908"

###################################################################################################
# CHATTER
#
#    Every bot is somebody in chat, too. There are 65 personalities - the joker, the braggart, the
#    grumbler, the newcomer, the veteran, the one who speaks like a knight of old, the one who
#    hardly speaks, the miser, the pirate, the poet, the trader, the drill sergeant, the snob, the
#    bard, the detective, the mother hen, the hermit, the tourist and many more - and a bot keeps
#    the one it has, so players get to know them (table mod_playerbots_auctions_personas).
#
#    Now and then one of them says something in the General channel of a zone a player is in, or
#    aloud next to a player: about the innkeeper or flight master it stands next to, a creature
#    that comes too close, the hour of the night, or nothing in particular. Or it makes a gesture.
#    They announce a new level and congratulate each other, name what killed them and what they
#    killed, and show what they found. They feel for a player who dies next to them, cheer when
#    one gains a level, and answer a wave, a bow or a rude gesture in kind. They answer when a
#    player says hello or goodbye, writes "ding", says thanks, asks for a joke or for help, or
#    talks about bots - in a channel, aloud or by whisper.
#
#    What they say comes from a catalog of more than 16000 lines, by personality and occasion. It
#    is built into the module (data/lines.txt) and copied into the table
#    mod_playerbots_auctions_lines of the characters database, where single lines can be switched
#    off (enabled = 0) and lines of your own added (give them ids from 1000000). The whispers of a
#    deal by chat come from the same catalog. Changes take effect at the next start.
#
#    mod-playerbots has chatter of its own: bots report every quest and every kill in the
#    channels and suggest dungeons. Installed through AFK Realm, the module switches that off in
#    playerbots.conf (EnableBroadcasts, RandomBotTalk, RandomBotSuggestDungeons and the two reply
#    chances); set them back there if you prefer it.
#
###################################################################################################

#
#    PlayerbotsAuctions.Chatter.Enable
#        Description: The bots talk.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Chatter.Enable = 1

#
#    PlayerbotsAuctions.Chatter.Interval
#        Description: About how many seconds lie between two things said out of the blue in a
#                     channel (20 to 3600). Lower is livelier. What is said aloud next to a player
#                     follows the same number, a little more seldom.
#        Default:     150

PlayerbotsAuctions.Chatter.Interval = 150

#
#    PlayerbotsAuctions.Chatter.Replies
#        Description: Bots answer a hello, a goodbye, a "ding", a thanks, a request for a joke or
#                     for help and talk about bots - one or two of them, after a few seconds, in
#                     General, Trade, the realm's channel or aloud.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Chatter.Replies = 1

#
#    PlayerbotsAuctions.Chatter.Nearby
#        Description: A bot that comes within earshot of a player now and then says something aloud
#                     or makes a gesture that suits it; more rarely one within shouting distance
#                     yells. When it is time and nobody is near, the next bot that passes speaks.
#        Default:     1 - Enabled
#                     0 - Disabled

PlayerbotsAuctions.Chatter.Nearby = 1

#
#    PlayerbotsAuctions.Chatter.WorldChannel
#        Description: With no bot in the player's zone that could say something, the channel of the
#                     whole realm is used instead (AiPlayerbot.BroadcastWorldChannelName in
#                     playerbots.conf), so a player alone in a zone still reads something.
#        Default:     1 - Enabled
#                     0 - Disabled (only the General channel of the zone)

PlayerbotsAuctions.Chatter.WorldChannel = 1

#
#    PlayerbotsAuctions.Chatter.Mixed
#        Description: Percent of the bots that are a mix of two personalities: mainly one, with a streak of
#                     another - the lazy one who keeps talking about food, the pirate who collects things.
#                     Such a bot takes about half of what it says from the first, a quarter from the second
#                     and the rest from what anybody would say. The others are one thing only, and all the
#                     more so. Who is what stays; bots that have a personality already keep it as their first.
#                     Pairs that would not be one person (the coward and the hero) do not come up.
#        Default:     65
#                     0 - Everybody is one personality only

PlayerbotsAuctions.Chatter.Mixed = 65

#
#    PlayerbotsAuctions.Chatter.EasterEggs
#        Description: Once in a very long while a bot says something that winks at where all this
#                     comes from: the realm that sleeps at night, the day the bots started talking,
#                     a tool called AFK Realm. One in this many of the things said out of the blue
#                     is such a line; with the default that is one every few evenings.
#        Default:     300
#                     0 - Never

PlayerbotsAuctions.Chatter.EasterEggs = 300
