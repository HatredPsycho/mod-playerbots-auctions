     return worldforged.contains(itemId);
 }
 
+// mod-playerbots-auctions: Bloodforged items (Conquest of Azeroth; every one is named "Bloodforged ...")
+// while the realm has them switched off (Bloodforged.Enable = 0). That switch only stops the extra world
+// drops; the items stay in some loot tables and in the item store the bots are geared from, so bots wore
+// them on realms without Bloodforged - often with models the client cannot show.
+bool PlayerbotFactory::IsCoaBloodforgedOff(ItemTemplate const* proto)
+{
+    static bool const enabled = sConfigMgr->GetOption<bool>("Bloodforged.Enable", false, false);
+    return !enabled && proto && proto->Name1.rfind("Bloodforged ", 0) == 0;
+}
